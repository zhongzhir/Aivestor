{
  "name": "investment-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "面向一级股权投资人的全周期 AI 工作台",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:formal-report": "node -r ts-node/register -r tsconfig-paths/register scripts/formal-report-composer.test.ts && node -r ts-node/register -r tsconfig-paths/register scripts/formal-report.test.ts",
    "test:user-profile-context": "node -r ts-node/register -r tsconfig-paths/register scripts/user-profile-context.test.ts",
    "test:project-management": "node -r ts-node/register -r tsconfig-paths/register scripts/project-management.test.ts",
    "test:export-publishing": "node -r ts-node/register -r tsconfig-paths/register scripts/export-publishing.test.ts",
    "test:project-soft-delete": "node -r ts-node/register -r tsconfig-paths/register scripts/project-soft-delete.test.ts",
    "test:intelligence": "node -r ts-node/register -r tsconfig-paths/register scripts/intelligence.test.ts",
    "test:intelligence-natural-language": "node -r ts-node/register -r tsconfig-paths/register scripts/intelligence-natural-language.test.ts",
    "test:intelligence-personal-access": "node -r ts-node/register -r tsconfig-paths/register scripts/intelligence-personal-access.test.ts",
    "test:intelligence-navigation": "node -r ts-node/register -r tsconfig-paths/register scripts/intelligence-navigation.test.ts",
    "test:db-permissions": "node scripts/db-permissions.test.mjs",
    "test:e2e:intelligence": "playwright test --config=playwright.intelligence.config.mjs",
    "db:schema": "node --env-file=.env.local scripts/apply-schema.mjs",
    "db:migrate": "node --env-file=.env.local scripts/apply-migration.mjs",
    "db:migrate-chunks": "node --env-file=.env.local -r ts-node/register -r tsconfig-paths/register scripts/migrate-chunks.ts",
    "db:backfill-embeddings": "node --env-file=.env.local -r ts-node/register -r tsconfig-paths/register scripts/backfill-embeddings.ts",
    "db:grant-app": "node --env-file=.env.local scripts/grant-app-db-permissions.mjs",
    "db:check-production": "node --env-file=.env.local scripts/check-production-schema.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@vercel/blob": "^2.3.3",
    "ali-oss": "^6.23.0",
    "bcryptjs": "^2.4.3",
    "docx": "^9.6.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "next": "14.2.18",
    "next-auth": "^4.24.14",
    "officeparser": "^7.0.3",
    "openai": "^6.38.0",
    "pg": "^8.13.1",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "unpdf": "^1.6.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/ali-oss": "^6.23.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
