# Database
DATABASE_URL="postgresql://user:password@localhost:5432/aivestor"

# App
NEXT_PUBLIC_APP_NAME="Aivestor"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Auth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Encryption
# AES-256-GCM master key for encrypting user model API keys.
# Must be a 64-character hex string.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Platform-sponsored quota (optional)
# Leave empty if every user should configure their own model API key.
# Live research validation uses this official credential. DEEPSEEK_API_KEY may
# be supplied as a temporary validation-only environment override.
SYSTEM_DEEPSEEK_API_KEY=""
SYSTEM_AI_PROVIDER="deepseek"
SYSTEM_AI_MODEL="deepseek-v4-flash"
FREE_QUOTA_TOKENS=5000000

# Optional remote document fetch allowlist.
# Required only when using a custom remote blob host instead of OSS/local storage.
DOCUMENT_REMOTE_ALLOWED_HOSTS=""

# Research retrieval (configure at least one; Tavily is the independent fallback)
# Tavily 为可选第二搜索源：填入 TAVILY_API_KEY 后与 Bailian 并行召回；
# 未配置时自动跳过（不影响检索状态，不会降级为 partial）。
BAILIAN_API_KEY=""
TAVILY_API_KEY=""

# DeepSeek Search / Fetch are standalone, per-request billed APIs. They remain
# opt-in even when a DeepSeek model key is configured. This is only a feature
# gate: every run still requires an explicit single-run authorization and a
# DeepSeek BYOK credential. Platform-paid credentials are always denied.
# Fetch has a separate per-run authorization and remains off in the first live
# comparison; remote provider DNS/redirect behavior is outside local SSRF checks.
INTELLIGENCE_DEEPSEEK_SEARCH_ENABLED="false"
INTELLIGENCE_DEEPSEEK_SEARCH_MAX_REQUESTS="2" # 代码硬上限同为 2；提高环境值不会放大预算
INTELLIGENCE_DEEPSEEK_FETCH_MAX_REQUESTS="0" # 首次真实验收禁用 Fetch
INTELLIGENCE_DEEPSEEK_FETCH_MODE="off" # off / fallback / prefer

# Deep Research Beta
# Beta defaults to platform admins only. Add comma-separated user UUIDs here;
# use "*" only after the feature is approved for all users.
DEEP_RESEARCH_BETA_USER_IDS=""

# File storage (optional)
# Leave empty to use local disk storage. Configure OSS only when shared storage is required.
OSS_REGION=""
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_BUCKET=""

# Email service (optional)
ALIYUN_ACCESS_KEY_ID=""
ALIYUN_ACCESS_KEY_SECRET=""
ALIYUN_EMAIL_FROM="noreply@yourdomain.com"

# SMS service (optional)
ALIYUN_SMS_SIGN=""
ALIYUN_SMS_TEMPLATE=""
