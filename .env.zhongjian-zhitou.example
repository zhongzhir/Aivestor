# 中鉴智投独立部署模板
# 复制为部署环境的 .env 后填写真实密钥；不要提交真实密钥。

NEXT_PUBLIC_BRAND_PROFILE=zhongjian-zhitou
NEXT_PUBLIC_APP_NAME="中鉴智投AI投资工作台"
NEXT_PUBLIC_APP_URL="https://aivestor.com.cn"
NEXTAUTH_URL="https://aivestor.com.cn"

# 独立实例必须使用独立密钥，初始化后不要更换。
NEXTAUTH_SECRET=""
ENCRYPTION_KEY=""

# 独立 PostgreSQL
DATABASE_URL="postgresql://zhongjian_zhitou:密码@独立数据库地址:5432/zhongjian_zhitou"

# 独立 OSS（建议使用专用 RAM 子账号）
OSS_REGION=""
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_BUCKET=""

# AI 与向量检索
BAILIAN_API_KEY=""
SYSTEM_DEEPSEEK_API_KEY=""
FREE_QUOTA_TOKENS=0

# 企业邮件/短信，按实际审核通过的配置填写
NEXT_PUBLIC_SUPPORT_EMAIL=""
ALIYUN_ACCESS_KEY_ID=""
ALIYUN_ACCESS_KEY_SECRET=""
ALIYUN_EMAIL_FROM=""
ALIYUN_SMS_SIGN=""
ALIYUN_SMS_TEMPLATE=""
