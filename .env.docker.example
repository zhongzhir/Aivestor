# Required

# PostgreSQL password used by docker-compose.yml.
DB_PASSWORD=your_strong_db_password

# Public URL for this deployment.
# Local deployment: http://localhost
# LAN/server deployment: http://your-server-ip or https://your-domain.com
NEXTAUTH_URL=http://localhost

# JWT signing secret.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret

# AES-256-GCM master key for encrypting user model API keys.
# Must be a 64-character hex string.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_64_char_hex_encryption_key

# AI and quota

# Optional embedding key for semantic knowledge search.
# Leave empty to fall back to keyword search.
BAILIAN_API_KEY=

# Optional platform-sponsored DeepSeek key.
# Leave empty if users should configure their own model API keys.
SYSTEM_DEEPSEEK_API_KEY=
FREE_QUOTA_TOKENS=5000000

# File storage

# Leave empty to store uploads in the Docker volume.
# Configure OSS only when shared storage or cloud backup is required.
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=

# Email password reset (optional)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_EMAIL_FROM=noreply@yourdomain.com

# SMS login (optional)
ALIYUN_SMS_SIGN=
ALIYUN_SMS_TEMPLATE=
